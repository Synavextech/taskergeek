{
  "name": "protgeek",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node dev.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild --bundle --platform=node --format=esm --outfile=dist/index.mjs --packages=external server/index.ts && npm run copy-configs",
    "copy-configs": "mkdir -p dist/config dist/data && cp -r server/config/* dist/config/ 2>/dev/null || true && cp -r server/data/* dist/data/ 2>/dev/null || true",
    "start": "NODE_ENV=production node dist/index.mjs",
    "start:dev": "NODE_ENV=development tsx server/index.ts",
    "check": "npx tsc",
    "pm2:start": "pm2 start dist/index.mjs --name promtasker",
    "pm2:stop": "pm2 stop promtasker",
    "pm2:restart": "pm2 restart promtasker",
    "pm2:logs": "pm2 logs promtasker"
  },
  "dependencies": {
